*.xlsx
*.xls
*.csv
*.tsv
*.ods
*.dump
*.sqlite
*.sqlite3
*.db
*.sql.gz

# ==========================================
# VARIÁVEIS DE AMBIENTE E CHAVES DE ACESSO
# Nunca envie chaves de API, Service Role ou senhas
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials*.json
serviceAccount*.json
client_secret*.json

# ==========================================
